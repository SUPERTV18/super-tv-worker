{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-tv-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["allow_custom_ports"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "DATA_KV",
      "id": "c73ecb5a1cf243ffbdc2ce89a2180831"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TRACKER", "class_name": "ViewerTracker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ViewerTracker"] }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
