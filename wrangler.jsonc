{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-tv-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-13",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "kv_namespaces": [
    { "binding": "DATA_KV", "id": "PUT_YOUR_KV_NAMESPACE_ID_HERE" }
  ]
}