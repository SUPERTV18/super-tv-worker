{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-tv-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["allow_custom_ports"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "DATA_KV",
      "id": "6f8fa9f54f844f51b03d76299911fb4a"
    }
  ]
}
